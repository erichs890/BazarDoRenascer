# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon-public

# Pix — chave que recebe os pagamentos. Ela aparece por extenso dentro de todo
# código Pix gerado, ou seja, é pública para quem for pagar. Para a instituição,
# use a chave CNPJ. Para teste pessoal, prefira chave aleatória ou e-mail a CPF.
# Formatos: e-mail em minúsculas | +5511999999999 | só dígitos do CPF/CNPJ | chave aleatória
VITE_PIX_KEY=
VITE_PIX_NAME=Bazar do Renascer
VITE_PIX_CITY=Sao Paulo

# Gateway (ver database/tutorial.md, passo 6c). Confirmação automática nos dois:
#   mercadopago-pro  Checkout Pro — paga na página do Mercado Pago (Pix, cartão, boleto)
#   mercadopago      Checkout Transparente — Pix e cartão dentro do app
#   vazio            Pix estático acima (admin confirma) e cartão/boleto simulados
# O Access Token do Mercado Pago NÃO vai aqui: ele fica nos secrets das Edge
# Functions.
VITE_PAYMENT_GATEWAY=

# Só para o modo "mercadopago" (transparente). Public Key do Mercado Pago
# (Suas integrações → Credenciais). É pública por definição: só serve para o
# formulário de cartão gerar o token no navegador. O Checkout Pro não usa.
VITE_MP_PUBLIC_KEY=
